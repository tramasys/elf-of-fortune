cabal-version: 3.0
name: elf-of-fortune
version: 0.1.0.0
synopsis: Let fortune choose how an ELF executable dies
description: A terminal roulette wheel that redirects an x86-64 ELF entry point to a fatal instruction.
category: System
license: NONE
build-type: Simple
extra-source-files:
    README.md
    tests/fixture.c

common warnings
    default-language: Haskell2010
    ghc-options:
        -Wall
        -Wextra
        -Wcompat
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wredundant-constraints

executable elf-of-fortune
    import: warnings
    main-is: Main.hs
    hs-source-dirs: src
    other-modules:
        Cli
        Elf
        Roulette
        Terminal
    build-depends:
        base >=4.14 && <5,
        bytestring >=0.10 && <0.13,
        directory >=1.3 && <1.4,
        filepath >=1.4 && <1.6,
        unix >=2.7 && <2.9
    ghc-options: -O2

executable fixtures
    import: warnings
    main-is: Fixtures.hs
    hs-source-dirs: tools
    other-modules: Project
    build-depends:
        base >=4.14 && <5,
        directory >=1.3 && <1.4,
        filepath >=1.4 && <1.6,
        process >=1.6 && <1.7

source-repository head
    type: git
    location: https://github.com/tramasys/elf-of-fortune.git
