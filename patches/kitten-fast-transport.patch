+decodeHexBytes :: Vector Rep -> Maybe (Vector Rep)
+decodeHexBytes encoded
+  | odd (Vector.length encoded) = Nothing
+  | otherwise = Vector.generateM (Vector.length encoded `div` 2) $ \ i -> do
+    high <- hexNibble $ encoded ! (i * 2)
+    low <- hexNibble $ encoded ! (i * 2 + 1)
+    return $ Int32 $ high * 16 + low
+  where
+    hexNibble (Character c)
+      | c >= '0' && c <= '9' = Just $ fromIntegral $ fromEnum c - fromEnum '0'
+      | c >= 'a' && c <= 'f' = Just $ fromIntegral $ fromEnum c - fromEnum 'a' + 10
+      | c >= 'A' && c <= 'F' = Just $ fromIntegral $ fromEnum c - fromEnum 'A' + 10
+    hexNibble _ = Nothing
