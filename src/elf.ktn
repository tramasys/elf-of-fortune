// Manual ELF64 parser.  It consumes only checked little-endian values from
// the hex-backed byte buffer; no native struct casts or libelf are involved.

type ExecRegion:
  case exec_region (Int32, UInt64, Int32, List<Char>, List<Char>)

define region_offset (ExecRegion -> Int32):
  match case exec_region -> offset, _, _, _, _: offset

define region_address (ExecRegion -> UInt64):
  match case exec_region -> _, address, _, _, _: address

define region_size (ExecRegion -> Int32):
  match case exec_region -> _, _, size, _, _: size

define region_name (ExecRegion -> List<Char>):
  match case exec_region -> _, _, _, name, _: name

define region_source (ExecRegion -> List<Char>):
  match case exec_region -> _, _, _, _, source: source

type ElfInfo:
  case elf_info (UInt64, List<ExecRegion>)

define elf_old_entry (ElfInfo -> UInt64):
  match case elf_info -> entry, _: entry

define elf_regions (ElfInfo -> List<ExecRegion>):
  match case elf_info -> _, regions: regions

type PatchPlan:
  case patch_plan
  (CrashInstruction, ExecRegion, Int32, UInt64, UInt64)

define patch_instruction (PatchPlan -> CrashInstruction):
  match case patch_plan -> instruction, _, _, _, _: instruction

define patch_region (PatchPlan -> ExecRegion):
  match case patch_plan -> _, region, _, _, _: region

define patch_offset (PatchPlan -> Int32):
  match case patch_plan -> _, _, offset, _, _: offset

define patch_address (PatchPlan -> UInt64):
  match case patch_plan -> _, _, _, address, _: address

define patch_old_entry (PatchPlan -> UInt64):
  match case patch_plan -> _, _, _, _, entry: entry

define checked_span (Int32, Int32, Int32, List<Char> -> +IO +Exit):
  -> offset, size, file_size, message;
  if (offset < 0 || { size < 0 }):
    message fatal
  elif (offset > file_size):
    message fatal
  elif (size > file_size - offset):
    message fatal

define checked_table
(Int32, Int32, Int32, Int32, List<Char> -> +IO +Exit):
  -> offset, entry_size, count, file_size, message;
  if (entry_size <= 0 || { count < 0 }):
    message fatal
  else:
    if (offset < 0 || { offset > file_size }):
      message fatal
    elif (count > (file_size - offset) entry_size quotient_i32):
      message fatal
    else {}

define validate_ident (List<Int32> -> +IO +Exit):
  -> data;
  data byte_count -> size;
  if (size < 4):
    "truncated ELF header" fatal
  elif (data 0 read_byte <> 0x7F):
    "not an ELF file" fatal
  elif (data 1 read_byte <> 0x45):
    "not an ELF file" fatal
  elif (data 2 read_byte <> 0x4C):
    "not an ELF file" fatal
  elif (data 3 read_byte <> 0x46):
    "not an ELF file" fatal
  elif (size < 64):
    "truncated ELF header" fatal
  elif (data 4 read_byte <> 2):
    "ELF32 is not supported" fatal
  elif (data 5 read_byte <> 1):
    "only little-endian ELF is supported" fatal
  elif (data 6 read_byte <> 1):
    "unsupported ELF identification version" fatal
  else {}

define validate_program_headers
(List<Int32>, Int32, Int32, Int32, Int32 -> +IO +Exit):
  -> data, phoff, phentsize, phnum, file_size;
  if (phnum = 0):
    if (phoff <> 0):
      "malformed program header table" fatal
  else:
    if (phentsize <> 56):
      "malformed program header table: invalid entry size" fatal
    elif (phoff = 0):
      "malformed program header table" fatal
    else:
      phoff phentsize phnum file_size
        "malformed program header table" checked_table
      data phoff phentsize phnum file_size 0
        validate_program_headers::entries

vocab validate_program_headers {
  define entries
  (List<Int32>, Int32, Int32, Int32, Int32, Int32 -> +IO +Exit):
    -> data, phoff, phentsize, phnum, file_size, index;
    if (index < phnum):
      phoff + index * phentsize -> header;
      data header read_u32_bits_le -> kind;
      data (header + 8) read_u64_index_le -> offset;
      data (header + 32) read_u64_index_le -> file_bytes;
      data (header + 40) read_u64_le -> memory_bytes;
      file_bytes int32_to_u64 -> file_bytes_u64;
      if (file_bytes_u64 > memory_bytes && { kind = 1 }):
        "malformed program header table: p_filesz exceeds p_memsz" fatal
      elif (file_bytes > 0):
        offset file_bytes file_size
          "malformed program header table: segment outside file" checked_span
      data phoff phentsize phnum file_size (index + 1) entries
}

define validate_section_table
(Int32, Int32, Int32, Int32 -> +IO +Exit):
  -> shoff, shentsize, shnum, file_size;
  if (shnum = 0):
    if (shoff <> 0):
      "malformed section header table: extended numbering is unsupported" fatal
  else:
    if (shentsize <> 64):
      "malformed section header table: invalid entry size" fatal
    elif (shoff = 0):
      "malformed section header table" fatal
    else:
      shoff shentsize shnum file_size
        "malformed section header table" checked_table

define known_section_name
(List<Int32>, Int32, Int32 -> Optional<List<Char>> +IO +Exit):
  -> data, offset, remaining;
  if (data offset remaining [0x2E, 0x74, 0x65, 0x78, 0x74]
      section_name_equals): ".text" some
  elif (data offset remaining [0x2E, 0x69, 0x6E, 0x69, 0x74]
      section_name_equals): ".init" some
  elif (data offset remaining [0x2E, 0x66, 0x69, 0x6E, 0x69]
      section_name_equals): ".fini" some
  elif (data offset remaining [0x2E, 0x70, 0x6C, 0x74]
      section_name_equals): ".plt" some
  elif (data offset remaining [0x2E, 0x70, 0x6C, 0x74, 0x2E, 0x67, 0x6F, 0x74]
      section_name_equals): ".plt.got" some
  elif (data offset remaining [0x2E, 0x70, 0x6C, 0x74, 0x2E, 0x73, 0x65, 0x63]
      section_name_equals): ".plt.sec" some
  else: none

define section_name_equals
(List<Int32>, Int32, Int32, List<Int32> -> Bool +IO +Exit):
  -> data, offset, remaining, expected;
  match (expected head_tail)
  case none:
    remaining > 0 && { data offset read_byte = 0 }
  case some:
    unpair -> first, rest;
    if (remaining <= 0):
      false
    elif (data offset read_byte <> first):
      false
    else:
      data (offset + 1) (remaining - 1) rest section_name_equals

define contains_nul
(List<Int32>, Int32, Int32 -> Bool +IO +Exit):
  -> data, offset, remaining;
  if (remaining <= 0):
    false
  elif (data offset read_byte = 0):
    true
  else:
    data (offset + 1) (remaining - 1) contains_nul

define section_label
(List<Int32>, Int32, Int32, Int32, Int32 -> List<Char> +IO +Exit):
  -> data, strings_offset, strings_size, name_offset, index;
  if (strings_size = 0):
    "section#" index show cat
  elif (name_offset < 0 || { name_offset >= strings_size }):
    "malformed section header table: invalid section name" fatal
  else:
    strings_offset + name_offset -> absolute;
    strings_size - name_offset -> remaining;
    if (data absolute remaining contains_nul not):
      "malformed section header table: unterminated section name" fatal
    match (data absolute remaining known_section_name)
    case some {}
    case none: "section#" index show cat

define section_is_text (ExecRegion -> Bool):
  region_name (".text" =)

define section_regions
(List<Int32>, Int32, Int32, Int32, Int32, Int32, Int32, Int32
 -> List<ExecRegion> +IO +Exit):
  -> data, shoff, shentsize, shnum, file_size,
    strings_offset, strings_size, index;
  if (index >= shnum):
    []
  else:
    shoff + index * shentsize -> header;
    data header read_u32_index_le -> name_offset;
    data (header + 4) read_u32_bits_le -> kind;
    data (header + 8) read_u64_le -> flags;
    data (header + 16) read_u64_le -> address;
    data (header + 24) read_u64_index_le -> offset;
    data strings_offset strings_size name_offset index section_label -> name;
    if (kind = 8):
      data shoff shentsize shnum file_size strings_offset strings_size
        (index + 1) section_regions
    else:
      data (header + 32) read_u64_index_le -> size;
      if (size > 0):
        offset size file_size
          "malformed section header table: section outside file" checked_span
      data shoff shentsize shnum file_size strings_offset strings_size
        (index + 1) section_regions -> rest;
      if (size > 0 && { (flags & 4u64) <> 0u64 }):
        "section:" name cat -> source;
        offset address size name source exec_region rest prepend
      else:
        rest

define discover_sections
(List<Int32>, Int32, Int32, Int32, Int32, Int32
 -> List<ExecRegion> +IO +Exit):
  -> data, shoff, shentsize, shnum, shstrndx, file_size;
  if (shstrndx < 0 || { shstrndx >= shnum }):
    "malformed section header table: invalid string table index" fatal
  else:
    if (shstrndx = 0):
      0 0
    else:
      shoff + shstrndx * shentsize -> strings_header;
      if (data (strings_header + 4) read_u32_bits_le <> 3):
        "malformed section header table: names are not a string table" fatal
      data (strings_header + 24) read_u64_index_le
      data (strings_header + 32) read_u64_index_le
    -> strings_offset, strings_size;
    if (strings_size > 0):
      strings_offset strings_size file_size
        "malformed section header table: string table outside file" checked_span
    data shoff shentsize shnum file_size strings_offset strings_size 0
      section_regions -> regions;
    regions \section_is_text filter
    regions { section_is_text not } filter cat

define segment_regions
(List<Int32>, Int32, Int32, Int32, Int32, Int32
 -> List<ExecRegion> +IO +Exit):
  -> data, phoff, phentsize, phnum, file_size, index;
  if (index >= phnum):
    []
  else:
    phoff + index * phentsize -> header;
    data header read_u32_bits_le -> kind;
    data (header + 4) read_u32_bits_le -> flags;
    data (header + 8) read_u64_index_le -> offset;
    data (header + 16) read_u64_le -> address;
    data (header + 32) read_u64_index_le -> size;
    data phoff phentsize phnum file_size (index + 1) segment_regions -> rest;
    if (kind = 1 && { (flags & 1) <> 0 } && { size > 0 }):
      "PT_LOAD#" index show cat -> name;
      "segment:" name cat -> source;
      offset address size name source exec_region rest prepend
    else:
      rest

define parse_elf (List<Int32> -> ElfInfo +IO +Exit):
  -> data;
  data validate_ident
  data byte_count -> file_size;
  data 0x10 read_u16_le -> kind;
  data 0x12 read_u16_le -> machine;
  data 0x14 read_u32_bits_le -> version;
  data 0x18 read_u64_le -> entry;
  data 0x20 read_u64_index_le -> phoff;
  data 0x28 read_u64_index_le -> shoff;
  data 0x34 read_u16_le -> ehsize;
  data 0x36 read_u16_le -> phentsize;
  data 0x38 read_u16_le -> phnum;
  data 0x3A read_u16_le -> shentsize;
  data 0x3C read_u16_le -> shnum;
  data 0x3E read_u16_le -> shstrndx;
  if (machine <> 62):
    "architecture is not x86-64" fatal
  elif (kind <> 2 && { kind <> 3 }):
    "only ET_EXEC and ET_DYN are supported" fatal
  elif (version <> 1):
    "unsupported ELF version" fatal
  elif (ehsize <> 64):
    "malformed ELF header: invalid header size" fatal
  elif (kind = 3 && { entry = 0u64 }):
    "ELF appears to be a shared library" fatal
  else {}
  data phoff phentsize phnum file_size validate_program_headers
  shoff shentsize shnum file_size validate_section_table
  if (shnum > 0):
    data shoff shentsize shnum shstrndx file_size discover_sections
      -> regions;
    if (regions empty):
      "no executable file-backed region found" fatal
    entry regions elf_info
  else:
    data phoff phentsize phnum file_size 0 segment_regions -> regions;
    if (regions empty):
      "no executable file-backed region found" fatal
    entry regions elf_info

define region_fits (ExecRegion, Int32 -> Bool):
  -> region, payload_size;
  region region_size >= payload_size

define create_patch
(List<Int32>, CrashInstruction, Int32 -> PatchPlan +IO +Exit):
  -> data, instruction, state1;
  data parse_elf -> elf;
  instruction crash_payload -> payload;
  elf elf_regions { payload length region_fits } filter -> candidates;
  if (candidates empty):
    "executable region too small for selected payload" fatal
  state1 candidates length rng_bounded -> state2, region_index;
  candidates region_index get
    "internal executable-region index out of range" require_some -> region;
  region region_size - payload length + 1 -> slots;
  state2 slots rng_bounded -> _, delta;
  region region_offset + delta -> offset;
  region region_address -> base_address;
  base_address + delta int32_to_u64 -> address;
  if (address < base_address):
    "malformed ELF: virtual address overflow" fatal
  instruction region offset address elf elf_old_entry patch_plan
