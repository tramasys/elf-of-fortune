type CliOptions:
  case cli_options
  (Optional<List<Char>>, Bool, Optional<List<Char>>, Bool, Bool, Bool,
   Optional<List<Char>>, Optional<List<Char>>)

define default_options (-> CliOptions):
  none false none false false false none none cli_options

define option_output (CliOptions -> Optional<List<Char>>):
  match case cli_options -> output, _, _, _, _, _, _, _: output

define option_in_place (CliOptions -> Bool):
  match case cli_options -> _, in_place, _, _, _, _, _, _: in_place

define option_seed (CliOptions -> Optional<List<Char>>):
  match case cli_options -> _, _, seed, _, _, _, _, _: seed

define option_no_anim (CliOptions -> Bool):
  match case cli_options -> _, _, _, no_anim, _, _, _, _: no_anim

define option_dry_run (CliOptions -> Bool):
  match case cli_options -> _, _, _, _, dry_run, _, _, _: dry_run

define option_help (CliOptions -> Bool):
  match case cli_options -> _, _, _, _, _, help, _, _: help

define option_instruction (CliOptions -> Optional<List<Char>>):
  match case cli_options -> _, _, _, _, _, _, instruction, _: instruction

define option_input (CliOptions -> Optional<List<Char>>):
  match case cli_options -> _, _, _, _, _, _, _, input: input

define set_output (CliOptions, List<Char> -> CliOptions):
  -> options, value;
  match (options)
  case cli_options -> _, a, b, c, d, e, f, g:
    value some a b c d e f g cli_options

define set_in_place (CliOptions -> CliOptions):
  match case cli_options -> a, _, b, c, d, e, f, g:
    a true b c d e f g cli_options

define set_seed (CliOptions, List<Char> -> CliOptions):
  -> options, value;
  match (options)
  case cli_options -> a, b, _, c, d, e, f, g:
    a b value some c d e f g cli_options

define set_no_anim (CliOptions -> CliOptions):
  match case cli_options -> a, b, c, _, d, e, f, g:
    a b c true d e f g cli_options

define set_dry_run (CliOptions -> CliOptions):
  match case cli_options -> a, b, c, d, _, e, f, g:
    a b c d true e f g cli_options

define set_help (CliOptions -> CliOptions):
  match case cli_options -> a, b, c, d, e, _, f, g:
    a b c d e true f g cli_options

define set_instruction (CliOptions, List<Char> -> CliOptions):
  -> options, value;
  match (options)
  case cli_options -> a, b, c, d, e, f, _, g:
    a b c d e f value some g cli_options

define set_input (CliOptions, List<Char> -> CliOptions):
  -> options, value;
  match (options)
  case cli_options -> a, b, c, d, e, f, g, _:
    a b c d e f g value some cli_options

define needs_value
(List<List<Char>>, List<Char> -> List<Char>, List<List<Char>> +IO +Exit):
  -> rest, option;
  match (rest head_tail)
  case none: option " requires a value" cat fatal
  case some: unpair

define parse_args
(List<List<Char>>, CliOptions -> CliOptions +IO +Exit):
  -> args, options;
  match (args head_tail)
  case none:
    if (options option_output is_some && { options option_in_place }):
      "--output and --in-place cannot be used together" fatal
    options
  case some:
    unpair -> argument, rest;
    if (argument = "-o" || { argument = "--output" }):
      if (options option_output is_some):
        "output path specified more than once" fatal
      rest argument needs_value -> value, tail_args;
      tail_args options value set_output parse_args
    elif (argument = "--in-place"):
      rest options set_in_place parse_args
    elif (argument = "--seed"):
      if (options option_seed is_some):
        "seed specified more than once" fatal
      rest argument needs_value -> value, tail_args;
      value validate_u64_seed
      tail_args options value set_seed parse_args
    elif (argument = "--no-anim"):
      rest options set_no_anim parse_args
    elif (argument = "--dry-run"):
      rest options set_dry_run parse_args
    elif (argument = "--help"):
      rest options set_help parse_args
    elif (argument = "--instruction"):
      if (options option_instruction is_some):
        "instruction specified more than once" fatal
      rest argument needs_value -> value, tail_args;
      value find_crash "unknown instruction for --instruction" require_some drop
      tail_args options value set_instruction parse_args
    elif (argument empty not && { argument 0 at = '-' }):
      "unknown option: " argument cat fatal
    else:
      if (options option_input is_some):
        "exactly one input file is required" fatal
      elif (rest empty not):
        "input must be the final argument" fatal
      rest options argument set_input parse_args

define read_protocol_i32 (-> Int32 +IO +Exit):
  get_line read "internal invalid native-host protocol" require_some

define read_arguments (Int32 -> List<List<Char>> +IO +Exit):
  -> count;
  if (count <= 0):
    []
  else:
    get_line (count - 1) read_arguments prepend

define destination_path (CliOptions, List<Char> -> List<Char> +IO +Exit):
  -> options, input;
  if (options option_in_place):
    input
  else:
    match (options option_output)
    case some {}
    case none: input ".doomed" cat

define help_text (-> List<Char>):
  """
elf-of-fortune [options] <input>

Options:
  -o, --output <path>    output path (default: <input>.doomed)
  --in-place             modify input after creating <input>.bak
  --seed <u64>           deterministic RNG seed
  --no-anim              disable carousel animation
  --dry-run              select everything but write nothing
  --help                 show this help

The resulting output is intentionally corrupted and should crash immediately.
"""

define write_response
(PatchPlan, List<Char>, Bool, List<Char> -> +IO +Exit):
  -> plan, output, in_place, input;
  if (in_place):
    "1"
  else:
    "0"
  -> in_place_text;
  "WRITE\n" output cat "\n" cat in_place_text cat "\n" cat
  input cat "\n" cat
  plan patch_offset show cat "\n" cat
  plan patch_instruction crash_payload transport_hex cat "\n" cat
  plan patch_address u64_le_transport_hex cat
  ".elf-of-fortune.response" write_file

define run (-> +IO +Exit):
  get_line -> protocol;
  if (protocol <> "ELF-OF-FORTUNE/1"):
    "internal invalid native-host protocol" fatal
  read_protocol_i32 -> stdout_tty;
  get_line -> entropy;
  read_protocol_i32 -> input_ok;
  get_line -> input_error;
  read_protocol_i32 read_arguments -> arguments;
  get_line -> input_hex;
  arguments default_options parse_args -> options;
  if (options option_help):
    help_text say
    "NONE\n" ".elf-of-fortune.response" write_file
  else:
    options option_input "missing input file" require_some -> input;
    if (input_ok = 0):
      "cannot read input '" input cat "': " cat input_error cat fatal
    match (options option_seed)
    case some -> seed_text: seed_text
    case none: entropy
    seed_to_state -> initial_state;
    options input destination_path -> destination;
    if (options option_in_place not && { destination = input }):
      "refusing to overwrite input without --in-place" fatal
    initial_state options option_instruction choose_crash -> instruction, patch_state;
    instruction crash_index -> selected;
    stdout_tty <> 0 -> ansi;
    if (options option_no_anim || { ansi not }):
      selected ansi show_static_wheel
    else:
      selected animate_wheel
    input_hex decode_hex_bytes instruction patch_state create_patch -> plan;
    plan input destination options option_dry_run show_summary
    if (options option_dry_run):
      "NONE\n" ".elf-of-fortune.response" write_file
    else:
      plan destination options option_in_place input write_response

run
