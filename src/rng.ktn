// Park-Miller "minimal standard" PRNG using Schrage's method.  This avoids
// Int32 multiplication overflow and is deterministic across Kitten versions.

define seed_digit (Char -> Optional<Int32>):
  -> c;
  if (c = '0'): 0 some
  elif (c = '1'): 1 some
  elif (c = '2'): 2 some
  elif (c = '3'): 3 some
  elif (c = '4'): 4 some
  elif (c = '5'): 5 some
  elif (c = '6'): 6 some
  elif (c = '7'): 7 some
  elif (c = '8'): 8 some
  elif (c = '9'): 9 some
  else: none

define read_seed_u64 (List<Char> -> Optional<UInt64>):
  read

define validate_u64_seed (List<Char> -> +IO +Exit):
  -> text;
  match (text read_seed_u64)
  case some -> _ {}
  case none: "invalid --seed value (expected u64)" fatal

define seed_to_state (List<Char> -> Int32 +IO +Exit):
  -> text;
  text validate_u64_seed
  text 0 seed_to_state::fold -> state;
  if (state = 0):
    1
  else:
    state

vocab seed_to_state {
  define fold (List<Char>, Int32 -> Int32 +IO +Exit):
    -> chars, state;
    match (chars head_tail)
    case none: state
    case some:
      unpair -> first, rest;
      first seed_digit "invalid --seed value (expected u64)" require_some
        -> digit;
      do (with (+Fail)):
        // Keep the multiply safely below Int32::MAX.
        rest ((state % 214748362) * 10 + digit) fold
}

define rng_next (Int32 -> Int32 +Fail):
  -> state;
  state / 127773 -> high;
  state % 127773 -> low;
  16807 * low - 2836 * high -> value;
  if (value <= 0):
    value + 2147483647
  else:
    value

define rng_bounded (Int32, Int32 -> Int32, Int32 +IO +Exit):
  -> state, bound;
  if (bound <= 0):
    "internal invalid random bound" fatal
  else:
    do (with (+Fail)):
      state rng_next -> next;
      next (next % bound)
