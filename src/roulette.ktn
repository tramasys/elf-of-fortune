type CrashInstruction:
  case crash_instruction
  (List<Char>, List<Int32>, List<Char>, List<Char>)

define crash_name (CrashInstruction -> List<Char>):
  match case crash_instruction -> name, _, _, _: name

define crash_payload (CrashInstruction -> List<Int32>):
  match case crash_instruction -> _, payload, _, _: payload

define crash_description (CrashInstruction -> List<Char>):
  match case crash_instruction -> _, _, description, _: description

define crash_signal (CrashInstruction -> List<Char>):
  match case crash_instruction -> _, _, _, signal: signal

define crash_instructions (-> List<CrashInstruction>):
  [
    "UD2" [0x0F, 0x0B]
      "invalid-opcode exception" "SIGILL" crash_instruction,
    "INT3" [0xCC]
      "breakpoint exception" "SIGTRAP" crash_instruction,
    "HLT" [0xF4]
      "privileged instruction from CPL3" "SIGSEGV" crash_instruction,
    "ICEBP" [0xF1]
      "debug exception" "SIGTRAP" crash_instruction,
    "UD1" [0x0F, 0xB9, 0xC0]
      "undefined-instruction exception" "SIGILL" crash_instruction,
    "LOCK NOP" [0xF0, 0x90]
      "invalid LOCK prefix usage" "SIGILL" crash_instruction,
  ]

define crash_at (Int32 -> CrashInstruction +IO +Exit):
  crash_instructions swap get
    "internal crash-instruction index out of range" require_some

define crash_index (CrashInstruction -> Int32 +IO +Exit):
  crash_name crash_instructions 0 crash_index::loop

vocab crash_index {
  define loop
  (List<Char>, List<CrashInstruction>, Int32 -> Int32 +IO +Exit):
    -> wanted, entries, index;
    match (entries head_tail)
    case none: "internal crash instruction is not on wheel" fatal
    case some:
      unpair -> first, rest;
      if (first crash_name = wanted):
        index
      else:
        wanted rest (index + 1) loop
}

define find_crash (List<Char> -> Optional<CrashInstruction>):
  crash_instructions swap find_crash::loop

vocab find_crash {
  define loop
  (List<CrashInstruction>, List<Char> -> Optional<CrashInstruction>):
    -> entries, wanted;
    match (entries head_tail)
    case none: none
    case some:
      unpair -> first, rest;
      if (first crash_name = wanted):
        first some
      else:
        rest wanted loop
}

define choose_crash
(Int32, Optional<List<Char>> -> CrashInstruction, Int32 +IO +Exit):
  -> state, forced;
  match (forced)
  case some -> wanted:
    wanted find_crash "unknown instruction for --instruction" require_some
    state
  case none:
    state crash_instructions length rng_bounded -> next, index;
    index crash_at next
