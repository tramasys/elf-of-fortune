define ansi_reverse (-> List<Char>):
  "[7m"

define ansi_reset (-> List<Char>):
  "[0m"

define ansi_rewind (-> List<Char>):
  "[4A[J"

define wheel_index (Int32 -> Int32):
  -> index;
  index 6 remainder_i32 -> reduced;
  if (reduced < 0):
    reduced + 6
  else:
    reduced

define wheel_name (Int32 -> List<Char> +IO +Exit):
  wheel_index crash_at crash_name

define highlighted_name (Int32, Bool -> List<Char> +IO +Exit):
  -> index, ansi;
  index wheel_name -> name;
  if (ansi):
    "[" ansi_reverse cat " " cat name cat " " cat ansi_reset cat "]" cat
  else:
    "[ " name cat " ]" cat

define wheel_line (Int32, Bool -> List<Char> +IO +Exit):
  -> center, ansi;
  (center - 2) wheel_name -> far_left;
  (center - 1) wheel_name -> left;
  center ansi highlighted_name -> middle;
  (center + 1) wheel_name -> right;
  (center + 2) wheel_name -> far_right;
  "      " far_left cat "   " cat left cat "  " cat middle cat
  "  " cat right cat "   " cat far_right cat

define render_wheel (Int32, Bool, Bool -> +IO +Exit):
  -> center, ansi, rewind;
  if (rewind): ansi_rewind print
  "             ELF OF FORTUNE\n" print
  "                   │\n" print
  center ansi wheel_line say
  "                   🐈" say
  _::kitten::flush_stdout

define frame_delay (Int32 -> Int32):
  -> frame;
  if (frame < 12): 75
  elif (frame < 18): 135
  elif (frame < 22): 225
  else: 390

define animate_wheel (Int32 -> +IO +Exit):
  0 animate_wheel::frames

vocab animate_wheel {
  define frames (Int32, Int32 -> +IO +Exit):
    -> selected, frame;
    if (frame < 24):
      selected + frame + 1 wheel_index -> center;
      center true (frame > 0) render_wheel
      if (frame < 23):
        "@@ELF_OF_FORTUNE_SLEEP@@" print
        frame frame_delay say
        _::kitten::flush_stdout
      selected (frame + 1) frames
}

define show_static_wheel (Int32, Bool -> +IO +Exit):
  -> selected, ansi;
  selected ansi false render_wheel

define show_summary
(PatchPlan, List<Char>, List<Char>, Bool -> +IO +Exit):
  -> plan, input, destination, dry_run;
  plan patch_instruction -> instruction;
  "" say
  "The cat has made its decision." say
  "" say
  "Victim:       " input cat say
  "Instruction:  " instruction crash_name cat say
  "Bytes:        " instruction crash_payload payload_hex cat say
  "Effect:       " instruction crash_description cat say
  "Signal:       " instruction crash_signal cat say
  "Region:       " plan patch_region region_source cat say
  "File offset:  0x" plan patch_offset 8 hex_i32 cat say
  "Address:      0x" plan patch_address 16 hex_u64 cat say
  "Old entry:    0x" plan patch_old_entry 16 hex_u64 cat say
  "New entry:    0x" plan patch_address 16 hex_u64 cat say
  "" say
  if (dry_run):
    "Dry run: no file was written." say
  else:
    "Destination: " destination cat say
